environment_current: high_performance
classifiers:
  AdaBoost:
  DecisionTree:
  EllipticEnvelope:
    random_state: 42
  GaussianMixtureModel:
  GradientBoosting:
  IsolationForest:
    random_state: 42
  KMeans:
  KNearestNeighbors:
  LocalOutlierFactor:
      novelty: True
  LogisticRegression:
  MultilayerPerceptron:
  NaiveBayes:
  One-classSVM:
  RandomForest:
  SVM:
  XGBoost:
data_type:
- subset_10_percent
- complete
clf_supervised:
- NaiveBayes
- RandomForest
- LogisticRegression
- DecisionTree
- KNearestNeighbors
- AdaBoost
- XGBoost
- GradientBoosting
- MultilayerPerceptron
- SVM
clf_unsupervised:
- KMeans
- One-classSVM
- IsolationForest
- EllipticEnvelope
- LocalOutlierFactor
- GaussianMixtureModel
environments:
  google_colab:
    RESULTS: /content/drive/My Drive/Doctorado/RESULTS
    ROOT: /content/drive/My Drive/Doctorado
    CONFIG_ROOT: /content/drive/My Drive/Mis_proyectos/preprocessor
    CHUNKSIZE: 500000
    NTRIALS: 50
    metric:
    - accuracy
    - f1-score
    - mcc
    - balanced-accuracy
    - manual-balanced-accuracy
    - gmean
    - kappa
    - manual-kappa
    - aucroc
    - aucpr
    - fbeta
    - fbetahalf
    - fbetatwice
    optimization_method:
    - TPE
    - RandomSearch
    - CMAES
#    - GridSearch
    - NSGAII
    classifiers:
    - NaiveBayes
    - RandomForest
    - LogisticRegression
    - DecisionTree
    - KNearestNeighbors
    - AdaBoost
    - XGBoost
    - GradientBoosting
    - MultilayerPerceptron
    - SVM
    - KMeans
    - One-classSVM
    - IsolationForest
    - EllipticEnvelope
    - LocalOutlierFactor
    - GaussianMixtureModel
    datasets_to_process:
    - IoTID20
    - N-baiot
    - Bot-IoT
    - Bot-IoT-full
    - DS2OS
    - Ton-IoT
    - IOT23
    - IOT23-10percent
    - CICIoTDataset2023
    sampling_methods:
    - none
    - SMOTE
    selector_datasets:
    - none
    - chi2
    - f_classif
    - mutual_info_classif
    - mutual_info_regression
  high_performance:
    RESULTS: /home/jiturbe/RESULTS
    ROOT: /home/jiturbe/Doctorado
    CHUNKSIZE: 500000
    NTRIALS: 50
    NUM_FEATURES: 40
    merge_tolerance_seconds: 300 # Tiempo en segundos para unir flujos cercanos
    use_temporal_matching: false
    metric:
    - accuracy
    - f1-score
    - mcc
    - balanced-accuracy
    - manual-balanced-accuracy
    - gmean
    - kappa
    - manual-kappa
    - aucroc
    - aucpr
    - fbeta
    - fbetahalf
    - fbetatwice
    optimization_method:
    - TPE
    - RandomSearch
    - CMAES
#    - GridSearch
    - NSGAII
    classifiers:
    - NaiveBayes
    - RandomForest
    - LogisticRegression
    - DecisionTree
    - KNearestNeighbors
    - AdaBoost
    - XGBoost
    - GradientBoosting
    - MultilayerPerceptron
    - SVM
    - KMeans
    - One-classSVM
    - IsolationForest
    - EllipticEnvelope
    - LocalOutlierFactor
    - GaussianMixtureModel
    datasets_to_process:
    - IoTID20
    - N-baiot
    - Bot-IoT
    - IoTID20-NFStream
    #- Bot-IoT-full
    #- DS2OS
    - Ton-IoT
    #- IOT23
    #- IOT23-10percent
    - CICIoTDataset2023
    sampling_methods:
    - none
    - SMOTE
    selector_datasets:
    - none
    - chi2
    - f_classif
    - mutual_info_classif
    - mutual_info_regression
  low_performance:
    metric:
    - f1-score
    - mcc
    optimization_method:
    - TPE
    classifiers:
    - KMeans
    - One-classSVM
    - IsolationForest
    - EllipticEnvelope
    - LocalOutlierFactor
    - GaussianMixtureModel
