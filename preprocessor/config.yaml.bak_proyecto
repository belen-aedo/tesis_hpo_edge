protocol_mapping:
  # --- Protocolos Fundamentales ---
  ip: 0
  hopopt: 0
  icmp: 1
  igmp: 2
  tcp: 6
  udp: 17
  ipv6: 41

  # --- Protocolos Comunes ---
  ggp: 3
  ipencap: 4
  st: 5
  egp: 8
  igp: 9
  pup: 12
  hmp: 20
  xns-idp: 22
  rdp: 27
  iso-tp4: 29
  dccp: 33
  xtp: 36
  ddp: 37
  idpr-cmtp: 38
  idrp: 45
  rsvp: 46
  gre: 47
  skip: 57
  rspf: 73
  vmtp: 81
  eigrp: 88
  ospf: 89
  ax25: 93
  ipip: 94
  etherip: 97
  encap: 98
  pim: 103
  ipcomp: 108
  vrrp: 112
  l2tp: 115
  isis: 124
  sctp: 132
  fc: 133
  udplite: 136
  mpls-in-ip: 137
  manet: 138
  hip: 139
  shim6: 140
  wesp: 141
  rohc: 142
  ethernet: 143
  mptcp: 262 # Usado por el Kernel de Linux

  # --- Protocolos de IPv6 y Seguridad (IPSec) ---
  ipv6-route: 43
  ipv6-frag: 44
  esp: 50
  ah: 51
  ipv6-icmp: 58
  ipv6-nonxt: 59
  ipv6-opts: 60
  mobility-header: 135
  arp: 2054   # Añade estos
  rarp: 2055  # El número puede ser el que estimes conveniente